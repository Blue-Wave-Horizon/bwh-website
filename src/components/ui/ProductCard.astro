---
// ProductCard.astro — one product on the Products page.
// Live products get the dark panel with an image; products in development get a quiet outlined card.
import type { Product } from '../../data/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const href = `/products/${product.slug}`;
const live = product.status === 'live';
---

{
  live ? (
    <article class="flex flex-col gap-8 overflow-hidden rounded-md border border-panel-line bg-panel p-6 text-white sm:p-10 lg:flex-row lg:items-center lg:gap-16 lg:p-14 reveal">
      <div class="flex flex-col gap-4 lg:flex-1">
        <p class="status text-primary">
          <span aria-hidden="true" class="h-2 w-2 rounded-full bg-primary" />
          <span>{product.statusLabel}</span>
        </p>
        <h2 class="h-section !text-white">{product.name}</h2>
        <p class="text-lg text-[#b8bcc8] sm:text-[19px]">{product.description}</p>
        <div class="mt-1 flex flex-col gap-x-7 sm:flex-row sm:flex-wrap">
          <a href={href} class="text-link-arrow !text-primary">About {product.name} &rarr;</a>
          {product.externalUrl && (
            <a href={product.externalUrl} class="text-link-arrow !text-primary">
              {product.externalLabel ?? 'Visit site'} &rarr;
            </a>
          )}
        </div>
      </div>
      {product.imageSrc && (
        <div class="w-full rounded-[9px] border border-[#343a47] bg-[#1c2029] p-[2px] shadow-[0_24px_60px_rgba(0,0,0,0.65)] sm:rounded-[15px] sm:p-[3px] lg:w-1/2 lg:flex-none">
          <img
            src={product.imageSrc}
            alt={product.imageAlt ?? ''}
            width="1400"
            height="618"
            loading="lazy"
            class="block h-auto w-full rounded-[7px] sm:rounded-[12px]"
          />
        </div>
      )}
    </article>
  ) : (
    <article class="flex flex-col gap-6 rounded-md border border-line-strong p-6 sm:p-10 lg:flex-row lg:items-end lg:justify-between lg:gap-16 lg:p-14 reveal">
      <div class="flex max-w-[620px] flex-col gap-4">
        <p class="status text-ink-mid">
          <span aria-hidden="true" class="h-2 w-2 rounded-full bg-accent" />
          <span>{product.statusLabel}</span>
        </p>
        <h2 class="h-section">{product.name}</h2>
        <p class="text-lg text-ink-mid sm:text-[19px]">{product.description}</p>
      </div>
      <a href={href} class="text-link-arrow shrink-0">About {product.name} &rarr;</a>
    </article>
  )
}
