---
// Button.astro — renders <a> when href is given, otherwise <button>.
// Variants: primary (cyan pill) | ink (dark pill, inverts in dark mode) | outline
interface Props {
  href?: string;
  variant?: 'primary' | 'ink' | 'outline';
  disabled?: boolean;
  external?: boolean; // adds target="_blank" rel="noopener noreferrer"
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
}

const {
  href,
  variant = 'primary',
  disabled = false,
  external = false,
  type = 'button',
  class: className = '',
  id,
} = Astro.props;

const variants: Record<string, string> = {
  primary: 'bg-primary text-[#1a1a2e] hover:opacity-85',
  ink: 'bg-navbtn-bg text-navbtn-fg hover:opacity-85',
  outline: 'border border-line-strong text-ink hover:bg-alt',
};

const classes = [
  'inline-flex min-h-[52px] cursor-pointer items-center justify-center gap-2 rounded-full px-8 font-body text-[17px] font-bold transition-opacity duration-150',
  variants[variant],
  disabled ? 'pointer-events-none cursor-not-allowed opacity-60' : '',
  className,
].join(' ');
---

{
  href ? (
    <a
      href={disabled ? undefined : href}
      id={id}
      class={classes}
      aria-disabled={disabled ? 'true' : undefined}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      <slot />
    </a>
  ) : (
    <button id={id} type={type} class={classes} disabled={disabled}>
      <slot />
    </button>
  )
}
