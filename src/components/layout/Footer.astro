---
const links = [
  { label: 'Products', href: '/products' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'VeloPad privacy', href: '/products/velopad/velopad-privacy' },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="wrap flex flex-col gap-4 pb-10 pt-8 text-sm text-muted lg:flex-row lg:items-center lg:justify-between">
    <div class="flex items-center gap-3">
      <img src="/images/logo-mark.png" alt="" width="442" height="260" class="h-6 w-auto" loading="lazy" />
      <span>&copy; {year} Blue Wave Horizon Ltd. &middot; RC 9357879 &middot; Uyo, Nigeria</span>
    </div>
    <nav class="flex flex-wrap gap-x-7" aria-label="Footer">
      {
        links.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 items-center transition-colors duration-150 hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
