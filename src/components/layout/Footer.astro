---
// §7 — Footer.astro
// bg-secondary (#0a718d) — the one dark element on the site.
// Three columns: logo+desc | quick links | legal info.
// Bottom bar: © notice.

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Products', href: '/products' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-secondary text-white relative overflow-hidden">
  <!-- Geometric dot texture overlay — §3 (opacity-[0.04]) -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="footer-dots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="white" opacity="0.04" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#footer-dots)" />
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Column 1: Logo mark + brief description -->
      <div>
        <a href="/" class="flex items-center gap-3 mb-4" aria-label="Blue Wave Horizon home">
          <img
            src="/images/logo.png"
            alt=""
            width="32"
            height="32"
            class="h-8 w-auto brightness-0 invert"
            aria-hidden="true"
            onerror="this.style.display='none'"
          />
          <span class="font-heading font-bold text-white text-sm">Blue Wave Horizon</span>
        </a>
        <p class="font-body text-white/70 text-sm leading-relaxed">
          A technology-driven startup building scalable software in PropTech and gaming utility.
        </p>
      </div>

      <!-- Column 2: Quick links -->
      <div>
        <h3 class="font-heading font-semibold text-white text-sm uppercase tracking-widest mb-5">
          Navigation
        </h3>
        <ul class="flex flex-col gap-2.5">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-body text-white/80 hover:text-white text-sm transition-colors duration-150"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Legal info — §7 spec (exact copy) -->
      <div>
        <h3 class="font-heading font-semibold text-white text-sm uppercase tracking-widest mb-5">
          Company
        </h3>
        <address class="not-italic font-body text-white/70 text-sm leading-relaxed space-y-1">
          <p class="text-white font-semibold font-heading">Blue Wave Horizon Ltd.</p>
          <p>RC 9357879</p>
          <p>D-U-N-S: 669828461</p>
          <p>4, Udo Ekong Close, Akpa Ube,</p>
          <p>Aka Road, Uyo, Akwa Ibom State, Nigeria</p>
        </address>
      </div>
    </div>
  </div>

  <!-- Bottom bar — §7 spec -->
  <div class="relative border-t border-white/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <p class="font-body text-white/50 text-xs text-center">
        &copy; 2026 Blue Wave Horizon Ltd. All rights reserved.
      </p>
    </div>
  </div>
</footer>
