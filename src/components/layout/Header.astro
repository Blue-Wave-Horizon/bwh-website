---
// §7 — Header.astro
// Sticky, cream/90 + backdrop-blur. Active link = text-secondary + border-b-2 border-primary.
// Mobile: hamburger toggles slide-down drawer. Vanilla JS, no frameworks.

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Products', href: '/products' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-cream/90 backdrop-blur-md border-b border-cream-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo + wordmark -->
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Blue Wave Horizon home">
        <img
          src="/images/logo.png"
          alt=""
          width="36"
          height="36"
          class="h-9 w-auto"
          aria-hidden="true"
          onerror="this.style.display='none'"
        />
        <span class="font-heading font-bold text-ink text-base leading-tight">
          Blue Wave Horizon
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={[
              'px-4 py-2 font-body text-sm rounded-md transition-colors duration-150',
              isActive(link.href)
                ? 'text-secondary font-semibold border-b-2 border-primary'
                : 'text-ink-mid hover:text-secondary',
            ].join(' ')}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex flex-col gap-1.5 p-2 rounded-md text-ink hover:bg-cream-mid transition-colors duration-150"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-ink" id="hamburger-1"></span>
        <span class="block w-6 h-0.5 bg-ink" id="hamburger-2"></span>
        <span class="block w-6 h-0.5 bg-ink" id="hamburger-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-cream border-b border-cream-dark"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <nav class="flex flex-col px-4 py-4 gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={[
            'px-4 py-3 font-body text-base rounded-lg transition-colors duration-150',
            isActive(link.href)
              ? 'text-secondary font-semibold bg-primary/10'
              : 'text-ink-mid hover:text-secondary hover:bg-cream-mid',
          ].join(' ')}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      menu?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    } else {
      menu?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    }
  });

  // Close drawer when a link inside it is clicked
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
