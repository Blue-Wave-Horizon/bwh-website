---
// VeloPad shown as its two halves: the PC client on a monitor, the Android app on a phone.
---

<div class="relative">
  <div class="flex w-[86%] flex-col items-center">
    <div class="w-full rounded-[5px] border border-[#343a47] bg-[#1c2029] p-[2px] sm:rounded-[7px] sm:p-1">
      <img
        src="/images/velopad/pc-dashboard.jpg"
        alt="VeloPad PC client dashboard showing live latency for a connected phone"
        width="1600"
        height="860"
        loading="lazy"
        class="block h-auto w-full rounded-[3px]"
      />
    </div>
    <div aria-hidden="true" class="h-5 w-10 border-x border-[#343a47] bg-[#1c2029] sm:h-8 sm:w-16 lg:h-11 lg:w-24"></div>
    <div aria-hidden="true" class="h-1.5 w-[60%] max-w-60 rounded-full border border-[#343a47] bg-[#262b36] sm:h-2.5"></div>
  </div>
  <div
    class="absolute bottom-0 right-0 w-[23%] max-w-[220px] rounded-[9px] border border-[#343a47] bg-[#1c2029] p-[2px] shadow-[0_24px_60px_rgba(0,0,0,0.65)] sm:w-[21%] sm:rounded-[15px] sm:p-[3px]"
  >
    <img
      src="/images/velopad/phone-home.jpg"
      alt="VeloPad Android app home screen showing the linked PC and the active controller layout"
      width="640"
      height="1375"
      loading="lazy"
      class="block h-auto w-full rounded-[7px] sm:rounded-[12px]"
    />
  </div>
</div>
