---
// ContactForm.astro
// Fields: Full name, Email, Subject (optional), Message.
// States: default | loading | success | error.
// Submits via fetch() POST to PUBLIC_WORKER_URL. On error the form is kept as typed.
const workerUrl = import.meta.env.PUBLIC_WORKER_URL ?? '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const field =
  'box-border w-full min-h-[52px] rounded border border-field bg-card px-4 py-3.5 font-body text-ink placeholder:text-muted';
---

<div>
  <div
    id="form-success"
    class="hidden flex-col gap-3 rounded border border-line-strong p-7 sm:p-10"
    role="status"
  >
    <h2 class="h-card">Message sent.</h2>
    <p class="text-ink-mid">Thanks for getting in touch. You'll hear back within two working days.</p>
  </div>

  <form id="contact-form" class="flex flex-col gap-6" novalidate>
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="flex flex-col gap-2">
        <label for="full-name" class="text-[15px] font-bold">Full name</label>
        <input id="full-name" name="name" type="text" required placeholder="Your name" autocomplete="name" class={field} />
      </div>
      <div class="flex flex-col gap-2">
        <label for="email-address" class="text-[15px] font-bold">Email address</label>
        <input id="email-address" name="email" type="email" required placeholder="you@example.com" autocomplete="email" class={field} />
      </div>
    </div>
    <div class="flex flex-col gap-2">
      <label for="subject" class="text-[15px] font-bold">
        Subject <span class="font-medium text-ink-mid">(optional)</span>
      </label>
      <input id="subject" name="subject" type="text" placeholder="What's this about?" class={field} />
    </div>
    <div class="flex flex-col gap-2">
      <label for="message" class="text-[15px] font-bold">Message</label>
      <textarea id="message" name="message" rows="7" required placeholder="What do you need built, and by when?" class={field + ' resize-y'}></textarea>
    </div>

    {/* Honeypot field: hidden from users & screen readers, catches auto-filling bots */}
    <div class="sr-only" aria-hidden="true">
      <label for="website">Website</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    {turnstileSiteKey && (
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
    )}

    <p id="form-error" class="hidden rounded border border-accent p-4 text-[15px] text-ink" role="alert">
      That didn't send. Check that your name, email and message are filled in and try again, or
      email <a href="mailto:hello@bluewavehz.com" class="font-bold text-link underline">hello@bluewavehz.com</a>.
    </p>

    <button
      id="submit-btn"
      type="submit"
      class="inline-flex min-h-[52px] cursor-pointer items-center justify-center gap-2.5 self-start rounded-full bg-primary px-8 font-body text-[17px] font-bold text-[#1a1a2e] transition-opacity duration-150 hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-60"
    >
      <svg id="submit-spinner" class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.3"></circle>
        <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
      </svg>
      <span id="submit-label">Send message</span>
    </button>
  </form>
</div>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script define:vars={{ workerUrl, hasTurnstile: Boolean(turnstileSiteKey) }}>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const submitLabel = document.getElementById('submit-label');
  const spinner = document.getElementById('submit-spinner');
  const successPanel = document.getElementById('form-success');
  const errorPanel = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Clear previous error
    errorPanel?.classList.add('hidden');

    // Basic client-side validation
    const name = (form.elements.namedItem('name')).value.trim();
    const email = (form.elements.namedItem('email')).value.trim();
    const subject = (form.elements.namedItem('subject')).value.trim();
    const message = (form.elements.namedItem('message')).value.trim();
    const website = (form.elements.namedItem('website'))?.value ?? '';
    const turnstileToken = (form.elements.namedItem('cf-turnstile-response'))?.value ?? '';

    if (!name || !email || !message || (hasTurnstile && !turnstileToken)) {
      errorPanel?.classList.remove('hidden');
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    submitLabel.textContent = 'Sending\u2026';
    spinner?.classList.remove('hidden');

    try {
      const res = await fetch(workerUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, subject, message, website, turnstileToken }),
      });

      if (res.ok) {
        // Success state — replace form with success panel
        form.classList.add('hidden');
        successPanel?.classList.remove('hidden');
        successPanel?.classList.add('flex');
      } else {
        throw new Error('Non-OK response');
      }
    } catch {
      // Error state — show error, keep form intact, reset Turnstile for retry
      if (hasTurnstile && window.turnstile) {
        window.turnstile.reset();
      }
      errorPanel?.classList.remove('hidden');
      submitBtn.disabled = false;
      submitLabel.textContent = 'Send message';
      spinner?.classList.add('hidden');
    }
  });
</script>
