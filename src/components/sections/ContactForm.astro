---
// §6.6 — ContactForm.astro
// Left column of the Contact page layout.
// Fields: Full Name, Email, Subject (optional), Message.
// States: default | loading | success | error.
// Submits via fetch() POST to PUBLIC_WORKER_URL. Vanilla JS only.
// On error: show error, do NOT clear form.

const workerUrl = import.meta.env.PUBLIC_WORKER_URL ?? '';
---

<div class="bg-white rounded-2xl border border-cream-dark p-8 md:p-10"
  style="box-shadow: 0 2px 12px rgba(26,26,46,0.07);">

  <!-- Success state (hidden by default) -->
  <div
    id="form-success"
    class="hidden flex-col items-center text-center py-8 gap-4"
    role="alert"
    aria-live="polite"
  >
    <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center">
      <!-- Checkmark icon in primary -->
      <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#18d8eb"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <h3 class="font-heading font-bold text-xl text-ink">Message sent!</h3>
    <p class="font-body text-ink-mid text-base">
      We'll get back to you as soon as we can.
    </p>
  </div>

  <!-- Form -->
  <form id="contact-form" novalidate class="space-y-6">
    <div>
      <label for="full-name" class="block font-heading font-semibold text-ink-mid text-sm mb-1.5">
        Full Name <span class="text-accent" aria-hidden="true">*</span>
      </label>
      <input
        id="full-name"
        name="name"
        type="text"
        required
        placeholder="Your name"
        autocomplete="name"
        class="w-full font-body text-ink text-base px-4 py-3 rounded-lg border border-cream-dark bg-cream focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-colors duration-150 placeholder:text-muted"
      />
    </div>

    <div>
      <label
        for="email-address"
        class="block font-heading font-semibold text-ink-mid text-sm mb-1.5"
      >
        Email Address <span class="text-accent" aria-hidden="true">*</span>
      </label>
      <input
        id="email-address"
        name="email"
        type="email"
        required
        placeholder="you@example.com"
        autocomplete="email"
        class="w-full font-body text-ink text-base px-4 py-3 rounded-lg border border-cream-dark bg-cream focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-colors duration-150 placeholder:text-muted"
      />
    </div>

    <div>
      <label for="subject" class="block font-heading font-semibold text-ink-mid text-sm mb-1.5">
        Subject
      </label>
      <input
        id="subject"
        name="subject"
        type="text"
        placeholder="What's this about?"
        class="w-full font-body text-ink text-base px-4 py-3 rounded-lg border border-cream-dark bg-cream focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-colors duration-150 placeholder:text-muted"
      />
    </div>

    <div>
      <label for="message" class="block font-heading font-semibold text-ink-mid text-sm mb-1.5">
        Message <span class="text-accent" aria-hidden="true">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        placeholder="Your message..."
        class="w-full font-body text-ink text-base px-4 py-3 rounded-lg border border-cream-dark bg-cream focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-colors duration-150 placeholder:text-muted resize-y"
      ></textarea>
    </div>

    <!-- Inline error — shown on submission failure. Form is NOT cleared. -->
    <div
      id="form-error"
      class="hidden p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 font-body text-sm"
      role="alert"
      aria-live="assertive"
    >
      Something went wrong. Please try again or email us directly at
      <a href="mailto:hello@dwellr.ng" class="underline font-semibold">hello@dwellr.ng</a>.
    </div>

    <!-- Submit -->
    <button
      id="submit-btn"
      type="submit"
      class="w-full bg-primary text-ink font-heading font-semibold px-6 py-3 rounded-lg hover:bg-secondary hover:text-white transition-colors duration-150 flex items-center justify-center gap-2"
    >
      <span id="submit-label">Send Message</span>
      <!-- Spinner (hidden by default) -->
      <svg
        id="submit-spinner"
        class="hidden animate-spin w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" stroke-opacity="0.25" />
        <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1" stroke-linecap="round" />
      </svg>
    </button>
  </form>
</div>

<script define:vars={{ workerUrl }}>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const submitLabel = document.getElementById('submit-label');
  const spinner = document.getElementById('submit-spinner');
  const successPanel = document.getElementById('form-success');
  const errorPanel = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Clear previous error
    errorPanel?.classList.add('hidden');

    // Basic client-side validation
    const name = (form.elements.namedItem('name')).value.trim();
    const email = (form.elements.namedItem('email')).value.trim();
    const subject = (form.elements.namedItem('subject')).value.trim();
    const message = (form.elements.namedItem('message')).value.trim();

    if (!name || !email || !message) {
      errorPanel?.classList.remove('hidden');
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    submitLabel.textContent = 'Sending\u2026';
    spinner?.classList.remove('hidden');

    try {
      const res = await fetch(workerUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, subject, message }),
      });

      if (res.ok) {
        // Success state — replace form with success panel
        form.classList.add('hidden');
        successPanel?.classList.remove('hidden');
        successPanel?.classList.add('flex');
      } else {
        throw new Error('Non-OK response');
      }
    } catch {
      // Error state — show error, keep form intact
      errorPanel?.classList.remove('hidden');
      submitBtn.disabled = false;
      submitLabel.textContent = 'Send Message';
      spinner?.classList.add('hidden');
    }
  });
</script>
