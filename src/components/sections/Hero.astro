---
// §6.1 — Hero.astro (Home page hero)
// Full-viewport, cream bg, subtle geometric texture, radial gradient upper-right,
// eyebrow badge with pulse dot, H1 with "Middleman" underlined in primary,
// subheading, two CTA buttons, animated scroll chevron.

import Button from '../ui/Button.astro';
---

<section class="relative min-h-screen flex flex-col items-center justify-center bg-cream overflow-hidden">

  <!-- Geometric dot-grid texture — §3 opacity-[0.05] in cream-dark -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-dot-grid" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="#e8e2d8" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-dot-grid)" opacity="0.05" />
    </svg>
  </div>

  <!-- Soft radial gradient upper-right — primary at ~8% opacity -->
  <div
    class="absolute top-0 right-0 w-2/3 h-2/3 pointer-events-none"
    style="background: radial-gradient(ellipse at top right, rgba(24,216,235,0.08) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-24">

    <!-- H1 — Option D -->
    <h1
      class="font-heading font-extrabold text-5xl md:text-6xl lg:text-7xl text-ink leading-tight mb-6"
    >
      Good Software<br />
      Takes Time.<br />
      We Take <span class="underline decoration-primary decoration-4 underline-offset-4">Our Time.</span>
    </h1>

    <!-- Subheading -->
    <p class="font-body text-lg md:text-xl text-ink-mid max-w-2xl mx-auto mb-10 leading-relaxed">
      Blue Wave Horizon is a small product studio with high standards. We build things that work, last, and matter.
    </p>

    <!-- CTA buttons row — §6.1 spec -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <Button href="/products" variant="primary">See Our Products</Button>
      <Button href="/contact" variant="outline">Get in Touch</Button>
    </div>
  </div>

  <!-- Scroll indicator — §6.1 spec: animated chevron-down, text-muted, 2s bounce loop -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-muted animate-bounce-chevron"
    aria-hidden="true"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>
