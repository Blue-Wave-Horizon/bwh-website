---
// Founder section. `full` is the longer About-page version.
interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
---

<section class="bg-alt">
  <div class="wrap section flex flex-col gap-10 md:flex-row md:items-center md:gap-16 lg:gap-20">
    <img
      src="/images/founder-photo.jpeg"
      alt="Kingsley Usa, founder of Blue Wave Horizon"
      width="567"
      height="756"
      loading="lazy"
      class:list={[
        'aspect-[3/4] w-full max-w-[280px] rounded-[5px] object-cover md:shrink-0',
        full ? 'md:max-w-[340px] lg:max-w-[380px]' : 'md:max-w-[300px] lg:max-w-[340px]',
      ]}
    />
    <div class="flex flex-col gap-5 sm:gap-6">
      {
        full ? (
          <>
            <p class="font-body text-sm font-semibold uppercase tracking-[0.08em] text-ink-mid">
              Founder and engineer
            </p>
            <h2 class="h-section">Kingsley Usa</h2>
            <p class="text-lg text-ink-mid sm:text-[19px]">
              Kingsley is a full-stack software engineer who specialises in backend systems, API
              architecture and data pipelines. He started Blue Wave Horizon to build the kind of
              software he wanted to exist.
            </p>
            <p class="text-lg text-ink-mid sm:text-[19px]">
              Every product and client project here is designed, built, shipped and maintained by
              him. If something breaks, you know exactly who to call.
            </p>
          </>
        ) : (
          <>
            <h2 class="h-section">One engineer. Start to finish.</h2>
            <p class="text-lg text-ink-mid sm:text-[19px]">
              Blue Wave Horizon is run by Kingsley Usa, a full-stack engineer. The person you talk
              to is the person who writes the code, ships it and fixes it. Nothing gets passed down
              a chain.
            </p>
            <dl class="mt-2 grid gap-x-8 gap-y-6 sm:grid-cols-3">
              <div class="border-t border-line-strong pt-5">
                <dt class="font-heading text-[17px] font-semibold">Ownership</dt>
                <dd class="mt-2 text-[15px] text-ink-mid">We build it, ship it and answer for it.</dd>
              </div>
              <div class="border-t border-line-strong pt-5">
                <dt class="font-heading text-[17px] font-semibold">Initiative</dt>
                <dd class="mt-2 text-[15px] text-ink-mid">
                  We spot the problem and move. Waiting isn't a plan.
                </dd>
              </div>
              <div class="border-t border-line-strong pt-5">
                <dt class="font-heading text-[17px] font-semibold">Craft</dt>
                <dd class="mt-2 text-[15px] text-ink-mid">
                  Fewer things, done properly. The details are the work.
                </dd>
              </div>
            </dl>
            <a href="/about" class="text-link-arrow self-start">More about the studio &rarr;</a>
          </>
        )
      }
    </div>
  </div>
</section>
