---
// Home page (/)
import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import DeviceShowcase from '../components/sections/DeviceShowcase.astro';
import FounderBio from '../components/sections/FounderBio.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
---

<BaseLayout
  title="Blue Wave Horizon | Independent software studio"
  description="Blue Wave Horizon builds and runs mobile apps, web platforms and desktop software. Makers of VeloPad."
>
  <Hero />

  <!-- What we build -->
  <section id="services" class="scroll-mt-20 bg-alt">
    <div class="wrap section flex flex-col gap-10 sm:gap-14 lg:gap-16">
      <div class="flex max-w-[640px] flex-col gap-4">
        <h2 class="h-section">What we build</h2>
        <p class="text-lg text-ink-mid sm:text-[19px]">
          Three kinds of software, and often the connections between them.
        </p>
      </div>
      <div class="grid gap-5 sm:gap-6 md:grid-cols-3">
        <FeatureCard title="Mobile apps">
          <svg slot="icon" class="mb-3 text-link sm:mb-4" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5"></rect><line x1="10.5" y1="18.5" x2="13.5" y2="18.5"></line></svg>
          Apps that feel right in the hand. Native performance, considered interfaces, and updates
          that don't break what already worked.
        </FeatureCard>
        <FeatureCard title="Web platforms">
          <svg slot="icon" class="mb-3 text-link sm:mb-4" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2.5"></rect><line x1="2" y1="9" x2="22" y2="9"></line><line x1="5.5" y1="6.5" x2="5.6" y2="6.5"></line><line x1="8.5" y1="6.5" x2="8.6" y2="6.5"></line></svg>
          Marketplaces, dashboards and the APIs behind them, built to stay fast as the data and the
          number of users grow.
        </FeatureCard>
        <FeatureCard title="Desktop software">
          <svg slot="icon" class="mb-3 text-link sm:mb-4" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="13" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="16" x2="12" y2="21"></line></svg>
          Desktop tools that talk to hardware, networks and other devices in real time, without
          getting in the user's way.
        </FeatureCard>
      </div>
    </div>
  </section>

  <!-- Our work -->
  <section id="work" class="wrap section flex scroll-mt-20 flex-col gap-10 sm:gap-14">
    <div class="flex max-w-[640px] flex-col gap-4">
      <h2 class="h-section">Our work</h2>
      <p class="text-lg text-ink-mid sm:text-[19px]">
        We ship our own products too, so we know what it takes to keep software running after
        launch day.
      </p>
    </div>

    <article class="flex flex-col gap-8 overflow-hidden rounded-md border border-panel-line bg-panel p-6 text-white sm:gap-12 sm:p-10 lg:gap-14 lg:p-14 reveal">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
        <div class="flex max-w-[560px] flex-col gap-4">
          <p class="font-body text-sm font-semibold uppercase tracking-[0.08em] text-primary">
            VeloPad &middot; Live on Google Play
          </p>
          <h3
            class="font-heading font-semibold"
            style="font-size: clamp(1.625rem, 3.2vw, 2.5rem); line-height: 1.12; letter-spacing: -0.03em;"
          >
            An Android phone that plays as a PC game controller.
          </h3>
          <p class="text-[#b8bcc8]">
            Tilt to aim, tap to shoot. The PC sees an Xbox controller, a DualShock, or a mouse and
            keyboard. We built the Android app, the PC client and the low-latency link between them.
          </p>
        </div>
        <a href="/products/velopad" class="text-link-arrow shrink-0 !text-primary">About VeloPad &rarr;</a>
      </div>
      <DeviceShowcase />
    </article>

    <article class="flex flex-col gap-3 rounded border border-line p-6 sm:px-10 sm:py-8 lg:flex-row lg:items-center lg:gap-10 reveal">
      <p class="status shrink-0 text-ink-mid">
        <span aria-hidden="true" class="h-2 w-2 rounded-full bg-accent"></span>
        <span>In development</span>
      </p>
      <h3 class="shrink-0 font-heading text-[22px] font-semibold tracking-[-0.02em]">
        <a href="/products/dwellr" class="text-ink hover:text-link">Dwellr</a>
      </h3>
      <p class="text-ink-mid">
        A rental marketplace that connects landlords and tenants in Nigeria directly, with no agent
        in between.
      </p>
    </article>
  </section>

  <FounderBio />

  <CtaBand
    title="Have something to build?"
    text="Tell us what you need. You'll get a straight answer on whether we're the right fit, usually within two working days."
  />
</BaseLayout>
