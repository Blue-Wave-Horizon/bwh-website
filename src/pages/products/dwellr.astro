---
// Dwellr (/products/dwellr) — teaser while the product is in development.
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import FeatureCard from '../../components/ui/FeatureCard.astro';
---

<BaseLayout
  title="Dwellr — Direct property rentals in Nigeria"
  description="Dwellr is a rental marketplace in development that connects landlords and tenants in Nigeria directly, with no agent in between."
>
  <PageHero
    centered
    status="coming-soon"
    statusLabel="Product · In development"
    title="Dwellr"
    lead="Rent directly. No agent in between."
  >
    <p class="max-w-[620px] text-lg text-ink-mid sm:text-[19px]">
      Dwellr is a rental marketplace for Nigeria where landlords and tenants deal with each other
      directly. It isn't open to the public yet.
    </p>
  </PageHero>

  <section class="bg-alt">
    <div class="wrap section flex flex-col gap-10 sm:gap-14">
      <h2 class="h-section">What we're building</h2>
      <div class="grid gap-5 sm:gap-6 md:grid-cols-3">
        <FeatureCard title="Direct listings">
          Landlords list their own properties. Tenants browse and apply without going through an
          agent.
        </FeatureCard>
        <FeatureCard title="One clear fee">
          A single service fee, stated up front. No agent commission and no surprise charges later.
        </FeatureCard>
        <FeatureCard title="Verified identities">
          Landlords and tenants both verify who they are before an agreement is made.
        </FeatureCard>
      </div>
    </div>
  </section>

  <CtaBand
    title="Want to know when it opens?"
    text="Send us a note and we'll tell you when Dwellr is ready for landlords and tenants."
  />
</BaseLayout>
