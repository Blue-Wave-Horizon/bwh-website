---
// Products overview (/products) — cards come from src/data/products.ts
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ProductGrid from '../../components/sections/ProductGrid.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
---

<BaseLayout
  title="Products — Blue Wave Horizon"
  description="Software Blue Wave Horizon builds and runs itself: VeloPad, live on Google Play, and Dwellr, in development."
>
  <PageHero
    eyebrow="Products"
    title="Software we build and run ourselves."
    lead="Alongside client work, Blue Wave Horizon makes its own products. One is live. One is on the way."
  />

  <section class="wrap pb-16 sm:pb-24 lg:pb-28" aria-label="Products">
    <ProductGrid />
  </section>

  <CtaBand
    tinted
    title="Want something like this built?"
    text="The same person who built these builds for clients too: mobile apps, web platforms and desktop software."
  />
</BaseLayout>
