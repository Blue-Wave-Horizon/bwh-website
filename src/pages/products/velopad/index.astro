---
// VeloPad overview (/products/velopad). The full product site lives at velopad.bluewavehz.com.
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import PageHero from '../../../components/sections/PageHero.astro';
import DeviceShowcase from '../../../components/sections/DeviceShowcase.astro';
import CtaBand from '../../../components/sections/CtaBand.astro';
import FeatureCard from '../../../components/ui/FeatureCard.astro';
import Button from '../../../components/ui/Button.astro';

const velopadSite = 'https://velopad.bluewavehz.com';

const parts = [
  {
    name: 'Android app',
    text: 'The controller itself. A native app with the layout editor and gyro handling.',
  },
  {
    name: 'PC client',
    text: "Receives the phone's input and presents it to the PC as a real controller. Shows live latency and lets you tune the feel.",
  },
  {
    name: 'The link',
    text: 'A low-latency connection between the two, over Wi-Fi or USB, that keeps input feeling immediate.',
  },
];
---

<BaseLayout
  title="VeloPad | Turn Your Android Phone Into a PC Controller"
  description="VeloPad turns an Android phone into a PC game controller with gyro aiming, over Wi-Fi or USB. Built by Blue Wave Horizon."
>
  <PageHero
    centered
    status="live"
    statusLabel="Product · Live on Google Play"
    title="VeloPad"
    lead="An Android phone that plays as a PC game controller."
  >
    <div class="mt-3 flex flex-col items-center gap-x-7 gap-y-2 sm:flex-row">
      <Button href={velopadSite}>Visit the VeloPad site</Button>
      <a href="/products/velopad/velopad-privacy" class="text-link-arrow">Privacy policy &rarr;</a>
    </div>
  </PageHero>

  <section class="wrap pb-16 sm:pb-24 lg:pb-28" aria-label="VeloPad on PC and phone">
    <div class="overflow-hidden rounded-md border border-panel-line bg-panel p-6 sm:p-10 lg:p-14 reveal">
      <DeviceShowcase />
    </div>
  </section>

  <section class="bg-alt">
    <div class="wrap section flex flex-col gap-10 sm:gap-14">
      <div class="flex max-w-[640px] flex-col gap-4">
        <h2 class="h-section">What it does</h2>
        <p class="text-lg text-ink-mid sm:text-[19px]">
          VeloPad was made for shooters, where precise aim matters most, and it works with PC games
          that take a controller or a mouse and keyboard.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 sm:gap-6">
        <FeatureCard title="Gyro aiming">
          Move the phone and the crosshair follows. The phone's motion sensor does the fine aiming a
          thumbstick struggles with.
        </FeatureCard>
        <FeatureCard title="Three controllers in one">
          The PC sees an Xbox controller, a DualShock, or a mouse and keyboard, depending on the
          layout you pick.
        </FeatureCard>
        <FeatureCard title="Wi-Fi or USB">
          Play without a cable over Wi-Fi, or plug in over USB for the lowest latency.
        </FeatureCard>
        <FeatureCard title="Your own layouts">
          Put buttons, sticks and touchpads where your thumbs want them, save the layout, and switch
          layouts per game.
        </FeatureCard>
      </div>
    </div>
  </section>

  <section class="wrap section flex flex-col gap-8 lg:flex-row lg:gap-20">
    <div class="flex flex-col gap-4 lg:flex-1">
      <h2 class="h-section">What we built</h2>
      <p class="text-lg text-ink-mid sm:text-[19px]">
        VeloPad is three pieces of software that have to agree with each other many times a second.
      </p>
    </div>
    <dl class="flex flex-col border-b border-line-strong lg:flex-[1.3]">
      {
        parts.map((part) => (
          <div class="flex flex-col gap-2 border-t border-line-strong py-6 sm:flex-row sm:gap-8 sm:py-7">
            <dt class="font-heading text-[19px] font-semibold sm:w-[180px] sm:shrink-0">{part.name}</dt>
            <dd class="text-ink-mid">{part.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <CtaBand
    tinted
    title="Try VeloPad"
    text="Downloads, setup guides and everything else live on VeloPad's own site. You need a PC and a phone running Android 8.0 or later."
    label="Go to velopad.bluewavehz.com"
    href={velopadSite}
  >
    <a href="https://github.com/Blue-Wave-Horizon/velopad-releases/releases" target="_blank" rel="noopener noreferrer" class="text-link-arrow">
      Download the PC client &rarr;
    </a>
  </CtaBand>
</BaseLayout>
