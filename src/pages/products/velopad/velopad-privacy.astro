---
// VeloPad Privacy Policy page — accessible from /products/velopad-privacy
// Linked from the VeloPad product page.

import BaseLayout from '../../../components/layout/BaseLayout.astro';
import PageHero from '../../../components/sections/PageHero.astro';
---

<BaseLayout
  title="VeloPad Privacy Policy — Blue Wave Horizon"
  description="VeloPad does not collect, store, or share your personal data. Read exactly what the app accesses, where it goes, and why."
>

  <PageHero eyebrow="VeloPad" title="Privacy Policy">
    <p class="text-ink-mid">
      Effective date: May 13, 2026 &nbsp;&middot;&nbsp; Developer: BWH (Blue Wave Horizon) &nbsp;&middot;&nbsp; App package: <code class="font-mono text-sm bg-alt px-1.5 py-0.5 rounded">com.bwh.velopad</code>
    </p>
  </PageHero>

  <section class="wrap flex flex-col gap-10 pb-20 sm:pb-28 lg:flex-row lg:items-start lg:gap-20">
    <nav
      class="flex flex-col border-y border-line-strong py-5 text-[15px] lg:sticky lg:top-24 lg:w-[280px] lg:shrink-0 lg:border-y-0 lg:py-0"
      aria-label="On this page"
    >
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.06em] text-ink-mid">On this page</p>
      <a href="#s1" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">1. Overview</a>
      <a href="#s2" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">2. Data Collected and How It Is Used</a>
      <a href="#s3" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">3. Permissions Used (Android)</a>
      <a href="#s4" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">4. Data Not Collected</a>
      <a href="#s5" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">5. Third-Party Services</a>
      <a href="#s6" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">6. Data Storage and Security</a>
      <a href="#s7" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">7. Children's Privacy</a>
      <a href="#s8" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">8. Data Sharing</a>
      <a href="#s9" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">9. Your Rights</a>
      <a href="#s10" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">10. Changes to This Policy</a>
      <a href="#s11" class="inline-flex min-h-10 items-center text-ink-mid transition-colors duration-150 hover:text-ink">11. Contact</a>
    </nav>

    <div class="min-w-0 max-w-[720px] [overflow-wrap:anywhere] lg:flex-1 prose-policy">

        <!-- ── 1. Overview ── -->
        <div class="mb-14 reveal">
          <h2 id="s1" class="scroll-mt-24 font-heading font-bold text-2xl md:text-3xl text-ink mb-4">1. Overview</h2>
          <div class="font-body text-ink-mid text-base leading-relaxed space-y-4">
            <p>
              VeloPad is a local-network game controller app made up of two parts:
            </p>
            <ul class="list-disc pl-6 space-y-2">
              <li><strong class="text-ink">VeloPad Android App</strong> — the mobile controller that runs on your Android device</li>
              <li><strong class="text-ink">VeloPad PC Client</strong> — the desktop receiver software that runs on Windows, Linux, or macOS</li>
            </ul>
            <p>
              Here's the short version: <strong class="text-ink">VeloPad does not collect, store, or share any personal data with third parties.</strong> All gameplay data stays on your local network, between your phone and your PC.
            </p>
            <p>
              The rest of this policy explains in detail what each component touches, why, and where it goes.
            </p>
          </div>
        </div>

        <!-- ── 2. Data Collected ── -->
        <div class="mb-14 reveal">
          <h2 id="s2" class="scroll-mt-24 font-heading font-bold text-2xl md:text-3xl text-ink mb-6">2. Data Collected and How It Is Used</h2>

          <h3 class="font-heading font-bold text-lg text-ink mb-4">2.1 Android App</h3>

          <!-- 2.1.1 -->
          <div class="mb-8 pl-4 border-l-2 border-accent/30">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.1.1 Sensor Data (Gyroscope / Accelerometer)</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> Raw rotation and acceleration values from the device's IMU sensors, read at up to 1000 Hz.</p>
              <p><strong class="text-ink">Why:</strong> To translate physical phone movement into mouse/aiming input for the PC client.</p>
              <p><strong class="text-ink">Where it goes:</strong> Sent in real time over a direct UDP/TCP socket to the VeloPad PC Client on your local Wi-Fi network. Never sent to any server, cloud service, or third party.</p>
              <p><strong class="text-ink">Retained:</strong> No. Sensor readings are discarded immediately after transmission.</p>
            </div>
          </div>

          <!-- 2.1.2 -->
          <div class="mb-8 pl-4 border-l-2 border-accent/30">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.1.2 Touch Input</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> Touch positions, deltas, and gesture events on the virtual controller layout (buttons, touchpad, joystick).</p>
              <p><strong class="text-ink">Why:</strong> To translate touch events into gamepad/mouse input for the PC client.</p>
              <p><strong class="text-ink">Where it goes:</strong> Sent in real time over the same local-network socket. Never sent externally.</p>
              <p><strong class="text-ink">Retained:</strong> No.</p>
            </div>
          </div>

          <!-- 2.1.3 -->
          <div class="mb-8 pl-4 border-l-2 border-accent/30">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.1.3 Local Network (Wi-Fi) Information</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> Your device's local IP address and the IP addresses of PCs broadcasting on your local network (discovered via UDP multicast).</p>
              <p><strong class="text-ink">Why:</strong> To find and connect to the VeloPad PC Client automatically, so you don't have to enter IP addresses manually.</p>
              <p><strong class="text-ink">Where it goes:</strong> Used only within the app for connection. Never transmitted to any server.</p>
              <p><strong class="text-ink">Retained:</strong> Not kept beyond the current session.</p>
            </div>
          </div>

          <!-- 2.1.4 -->
          <div class="mb-8 pl-4 border-l-2 border-accent/30">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.1.4 App Preferences and Settings</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> User preferences including polling rate, selected profile name, Wi-Fi connection settings (IP/port), and boolean flags (e.g. TCP mode).</p>
              <p><strong class="text-ink">Where it is stored:</strong> In Android <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">SharedPreferences</code> on the device. Local only, never uploaded.</p>
              <p><strong class="text-ink">Access:</strong> Only VeloPad reads these preferences. No other app or service has access.</p>
            </div>
          </div>

          <!-- 2.1.5 -->
          <div class="mb-8 pl-4 border-l-2 border-accent/30">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.1.5 Controller Profiles</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> Named controller layout configurations (button placements, gyro settings, curve settings), stored as <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">.vpd</code> files.</p>
              <p><strong class="text-ink">Where:</strong> Stored locally on your device. You can optionally sync profiles between the Android app and the PC Client over your local Wi-Fi network.</p>
              <p><strong class="text-ink">Where it goes:</strong> Profile sync transfers files directly between your phone and your PC over the local network. Profile data never leaves your local network.</p>
            </div>
          </div>

          <!-- 2.1.6 -->
          <div class="mb-8 pl-4 border-l-2 border-accent/30">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.1.6 Purchase Token <span class="font-normal text-muted">(VeloPad Pro subscribers only)</span></h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> A Google Play subscription purchase token issued by Google Play Billing when you subscribe to VeloPad Pro.</p>
              <p><strong class="text-ink">Why:</strong> To verify that your subscription is active and to obtain a signed entitlement token.</p>
              <p><strong class="text-ink">Where it goes:</strong> Sent via HTTPS POST to a Firebase Cloud Function operated by the developer (<code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">https://us-central1-velopad-be.cloudfunctions.net/verify</code>). The function validates the token against the Google Play Developer API and returns a signed JWT. <strong class="text-ink">The purchase token is not stored on the server</strong> — it is used transiently for verification only.</p>
              <p><strong class="text-ink">What the server receives:</strong> The purchase token and your app's package name (<code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">com.bwh.velopad</code>). No other personal data (name, email, device ID, IP address) is transmitted.</p>
              <p><strong class="text-ink">What the server returns:</strong> A signed JWT encoding only your subscription tier (<code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">PRO</code>) and expiry time. No personal information is included.</p>
            </div>
          </div>

          <!-- 2.1.7 -->
          <div class="mb-10 pl-4 border-l-2 border-accent/30">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.1.7 Entitlement JWT <span class="font-normal text-muted">(VeloPad Pro subscribers only)</span></h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> The signed JWT returned from the verification server.</p>
              <p><strong class="text-ink">Where it is stored:</strong> In <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">EncryptedSharedPreferences</code> on your Android device (AES-256 encrypted, protected by the Android Keystore). Local only.</p>
              <p><strong class="text-ink">Why:</strong> So the app can confirm your Pro status on launch without an internet round-trip every time.</p>
              <p><strong class="text-ink">Where it goes:</strong> When your PC Client connects and queries your entitlement status, the JWT is transmitted over the local Wi-Fi connection. The PC Client verifies the JWT's cryptographic signature locally, offline. The JWT never leaves your local network during gameplay.</p>
            </div>
          </div>

          <h3 class="font-heading font-bold text-lg text-ink mb-4">2.2 PC Client (Windows)</h3>

          <!-- 2.2.1 -->
          <div class="mb-8 pl-4 border-l-2 border-cream-dark">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.2.1 Local Network Listening</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> The PC Client opens a UDP socket (default port 5005) and a TCP socket to receive data from the Android app.</p>
              <p><strong class="text-ink">Where it goes:</strong> All data received is processed in memory and translated into virtual input events (mouse movement, keystrokes, gamepad input). Nothing is forwarded to any server.</p>
              <p><strong class="text-ink">Retained:</strong> No. Nothing is kept beyond the active session.</p>
            </div>
          </div>

          <!-- 2.2.2 -->
          <div class="mb-8 pl-4 border-l-2 border-cream-dark">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.2.2 Controller Profiles</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> Controller layout configurations stored as <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">.vpd</code> files in the PC Client's local <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">profiles/</code> directory.</p>
              <p><strong class="text-ink">Where:</strong> Local disk only. Never uploaded.</p>
              <p><strong class="text-ink">Profile sync:</strong> When the user triggers a sync, files are transferred directly between PC and phone over the local Wi-Fi network.</p>
            </div>
          </div>

          <!-- 2.2.3 -->
          <div class="mb-8 pl-4 border-l-2 border-cream-dark">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.2.3 App Settings and Configuration</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed">
              <p><strong class="text-ink">What:</strong> Application configuration including window preferences, last-used profile, and connection settings.</p>
              <p class="mt-2"><strong class="text-ink">Where:</strong> Stored in a local configuration file on the user's machine. Local only, never transmitted.</p>
            </div>
          </div>

          <!-- 2.2.4 -->
          <div class="mb-8 pl-4 border-l-2 border-cream-dark">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.2.4 Update Check</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed space-y-2">
              <p><strong class="text-ink">What:</strong> The PC Client optionally checks for software updates by querying the GitHub Releases API at <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">https://api.github.com/repos/Blue-Wave-Horizon/velopad-releases/releases/latest</code>.</p>
              <p><strong class="text-ink">What is sent:</strong> A standard HTTPS GET request with the <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">User-Agent</code> header <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">VeloPad-Update-Checker</code>. No personal data, no device identifiers, no user information.</p>
              <p><strong class="text-ink">What is received:</strong> The latest release version number and a download URL, displayed in the UI only.</p>
              <p><strong class="text-ink">When:</strong> Only when you open the app or manually trigger an update check. You can block this request at the firewall without affecting any app functionality.</p>
            </div>
          </div>

          <!-- 2.2.5 -->
          <div class="mb-8 pl-4 border-l-2 border-cream-dark">
            <h4 class="font-heading font-semibold text-base text-ink mb-2">2.2.5 Entitlement Verification</h4>
            <div class="font-body text-ink-mid text-sm leading-relaxed">
              <p>When a VeloPad Pro subscriber connects their Android device, the PC Client receives the JWT from the phone over the local network and verifies it cryptographically offline using an embedded RSA public key. <strong class="text-ink">The PC Client makes no internet request for license verification.</strong></p>
            </div>
          </div>
        </div>

        <!-- ── 3. Permissions ── -->
        <div class="mb-14 reveal">
          <h2 id="s3" class="scroll-mt-24 font-heading font-bold text-2xl md:text-3xl text-ink mb-6">3. Permissions Used (Android)</h2>
          <div class="overflow-x-auto">
            <table class="w-full font-body text-sm text-ink-mid border-collapse">
              <thead>
                <tr class="border-b-2 border-cream-dark">
                  <th class="text-left font-heading font-semibold text-ink py-3 pr-6 w-64">Permission</th>
                  <th class="text-left font-heading font-semibold text-ink py-3">Reason</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-6 align-top"><code class="font-mono text-xs bg-cream px-1.5 py-0.5 rounded">INTERNET</code></td>
                  <td class="py-3 leading-relaxed">Required to contact the Firebase verification server (Pro subscribers only) and to communicate with the PC Client over the local network</td>
                </tr>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-6 align-top"><code class="font-mono text-xs bg-cream px-1.5 py-0.5 rounded">ACCESS_NETWORK_STATE</code></td>
                  <td class="py-3 leading-relaxed">Detect whether a network connection is available before attempting communication</td>
                </tr>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-6 align-top"><code class="font-mono text-xs bg-cream px-1.5 py-0.5 rounded">ACCESS_WIFI_STATE</code></td>
                  <td class="py-3 leading-relaxed">Read local Wi-Fi network information (local IP address) for connection setup</td>
                </tr>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-6 align-top"><code class="font-mono text-xs bg-cream px-1.5 py-0.5 rounded">CHANGE_WIFI_MULTICAST_STATE</code></td>
                  <td class="py-3 leading-relaxed">Enable UDP multicast for automatic PC discovery on the local network</td>
                </tr>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-6 align-top"><code class="font-mono text-xs bg-cream px-1.5 py-0.5 rounded">HIGH_SAMPLING_RATE_SENSORS</code></td>
                  <td class="py-3 leading-relaxed">Access the gyroscope and accelerometer at high polling rates (up to 1000 Hz) for smooth aiming</td>
                </tr>
                <tr>
                  <td class="py-3 pr-6 align-top"><code class="font-mono text-xs bg-cream px-1.5 py-0.5 rounded">VIBRATE</code></td>
                  <td class="py-3 leading-relaxed">Provide haptic feedback on button presses in the controller layout</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="font-body text-sm text-ink-mid mt-4 leading-relaxed">
            No location permission is requested or used. Wi-Fi state access is used only to read the local IP address — it does not reveal your geographic location.
          </p>
        </div>

        <!-- ── 4. Data Not Collected ── -->
        <div class="mb-14 reveal">
          <h2 id="s4" class="scroll-mt-24 font-heading font-bold text-2xl md:text-3xl text-ink mb-4">4. Data Not Collected</h2>
          <p class="font-body text-ink-mid text-base leading-relaxed mb-4">VeloPad does <strong class="text-ink">not</strong> collect any of the following:</p>
          <ul class="font-body text-ink-mid text-sm leading-relaxed list-disc pl-6 space-y-1.5">
            <li>Your name, email address, or any account credentials</li>
            <li>Your Google account information</li>
            <li>Your device's unique identifiers (IMEI, advertising ID, Android ID)</li>
            <li>Your location (GPS or network-based)</li>
            <li>Your contacts, calendar, or any other personal data stored on your device</li>
            <li>Diagnostic data, crash reports, or analytics</li>
            <li>Any data for advertising or marketing purposes</li>
            <li>Any data about what games you play or how you use the controller</li>
          </ul>
        </div>

        <!-- ── 5. Third-Party Services ── -->
        <div class="mb-14 reveal">
          <h2 id="s5" class="scroll-mt-24 font-heading font-bold text-2xl md:text-3xl text-ink mb-6">5. Third-Party Services</h2>
          <p class="font-body text-ink-mid text-base leading-relaxed mb-6">VeloPad interacts with two external services under specific, limited circumstances:</p>

          <div class="space-y-8">
            <div>
              <h3 class="font-heading font-bold text-lg text-ink mb-2">5.1 Google Play Billing (VeloPad Pro)</h3>
              <p class="font-body text-ink-mid text-sm leading-relaxed">
                When you subscribe to VeloPad Pro, your purchase is processed by Google Play. Google's handling of payment data is governed by <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-2">Google's Privacy Policy</a>. VeloPad receives only an opaque purchase token from Google — no payment card details or billing address are ever passed to VeloPad or its servers.
              </p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-lg text-ink mb-2">5.2 Firebase Cloud Functions (VeloPad Pro, Subscription Verification)</h3>
              <p class="font-body text-ink-mid text-sm leading-relaxed mb-3">
                A Firebase Cloud Function hosted in the <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">us-central1</code> region (Google Cloud infrastructure) is called to validate your subscription token. This function:
              </p>
              <ul class="font-body text-ink-mid text-sm leading-relaxed list-disc pl-6 space-y-1.5">
                <li>Receives: your Google Play purchase token and package name</li>
                <li>Calls: Google Play Developer API to confirm the subscription is active</li>
                <li>Returns: a signed JWT with your subscription tier and expiry</li>
                <li>Stores: nothing — the function is stateless and retains no data</li>
              </ul>
              <p class="font-body text-ink-mid text-sm leading-relaxed mt-3">
                Firebase infrastructure logs (managed by Google) may record the IP address of the request as part of standard server-side access logging. VeloPad has no control over these logs; they are managed by Google under <a href="https://cloud.google.com/terms/data-processing-addendum" target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-2">Google Cloud's data processing terms</a>.
              </p>
            </div>

            <div>
              <h3 class="font-heading font-bold text-lg text-ink mb-2">5.3 GitHub Releases API (PC Client Update Check)</h3>
              <p class="font-body text-ink-mid text-sm leading-relaxed">
                The PC Client may contact <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">api.github.com</code> to check for updates. GitHub's privacy policy applies to this request: <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer" class="text-link underline underline-offset-2">GitHub General Privacy Statement</a>. No personal data is transmitted in this request.
              </p>
            </div>
          </div>
        </div>

        <!-- ── 6. Data Storage and Security ── -->
        <div class="mb-14 reveal">
          <h2 id="s6" class="scroll-mt-24 font-heading font-bold text-2xl md:text-3xl text-ink mb-6">6. Data Storage and Security</h2>
          <div class="overflow-x-auto">
            <table class="w-full font-body text-sm text-ink-mid border-collapse">
              <thead>
                <tr class="border-b-2 border-cream-dark">
                  <th class="text-left font-heading font-semibold text-ink py-3 pr-4">Data</th>
                  <th class="text-left font-heading font-semibold text-ink py-3 pr-4">Location</th>
                  <th class="text-left font-heading font-semibold text-ink py-3">Encryption</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-4 align-top leading-relaxed">App preferences (polling rate, IP, etc.)</td>
                  <td class="py-3 pr-4 align-top leading-relaxed">Android <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">SharedPreferences</code></td>
                  <td class="py-3 align-top leading-relaxed">Android OS file system protection</td>
                </tr>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-4 align-top leading-relaxed">Entitlement JWT</td>
                  <td class="py-3 pr-4 align-top leading-relaxed">Android <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">EncryptedSharedPreferences</code></td>
                  <td class="py-3 align-top leading-relaxed">AES-256, Android Keystore</td>
                </tr>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-4 align-top leading-relaxed">Controller profiles (Android)</td>
                  <td class="py-3 pr-4 align-top leading-relaxed">Android app internal storage</td>
                  <td class="py-3 align-top leading-relaxed">Android OS file system protection</td>
                </tr>
                <tr class="border-b border-cream-dark">
                  <td class="py-3 pr-4 align-top leading-relaxed">Controller profiles (PC)</td>
                  <td class="py-3 pr-4 align-top leading-relaxed">Local <code class="font-mono text-xs bg-alt px-1 py-0.5 rounded">profiles/</code> folder</td>
                  <td class="py-3 align-top leading-relaxed">OS file system (user's responsibility)</td>
                </tr>
                <tr>
                  <td class="py-3 pr-4 align-top leading-relaxed">PC Client settings</td>
                  <td class="py-3 pr-4 align-top leading-relaxed">Local config file</td>
                  <td class="py-3 align-top leading-relaxed">OS file system (user's responsibility)</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="font-body text-sm text-ink-mid mt-4">No user data is stored in the cloud by VeloPad.</p>
        </div>

        <!-- ── 7. Children's Privacy ── -->
