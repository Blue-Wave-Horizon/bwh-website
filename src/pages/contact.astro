---
// §6.6 — Contact page (/contact)
// Two-column: left = ContactForm, right = Company Info Panel.
// SEO: §9 spec.

import BaseLayout from '../components/layout/BaseLayout.astro';
import ContactForm from '../components/sections/ContactForm.astro';
---

<BaseLayout
  title="Contact — Blue Wave Horizon"
  description="Get in touch with Blue Wave Horizon for partnerships, enquiries, or press."
>

  <!-- ───── Page Hero — §6.6 ───── -->
  <section class="py-20 md:py-24 bg-cream-mid relative overflow-hidden">
    <div
      class="absolute left-0 top-0 bottom-0 w-[3px] bg-primary"
      aria-hidden="true"
    ></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <!-- §6.6 spec -->
        <h1 class="font-heading font-extrabold text-4xl md:text-5xl text-ink mb-4 leading-tight">
          Get in Touch
        </h1>
        <p class="font-body text-lg text-ink-mid leading-relaxed">
          Have a question, a partnership proposal, or just want to say hello?
        </p>
      </div>
    </div>
  </section>

  <!-- ───── Two-column layout — §6.6 ───── -->
  <section class="py-20 md:py-28 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

        <!-- Left: Contact Form -->
        <div>
          <ContactForm />
        </div>

        <!-- Right: Company Info Panel — §6.6 spec -->
        <div>
          <div
            class="bg-white rounded-2xl border border-cream-dark p-8 reveal"
            style="box-shadow: 0 2px 12px rgba(26,26,46,0.07);"
          >
            <h2 class="font-heading font-bold text-xl text-ink mb-6">Contact Info</h2>

            <ul class="space-y-5">

              <!-- Email — §6.6 spec -->
              <li class="flex items-start gap-4">
                <span
                  class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5"
                  aria-hidden="true"
                >
                  <!-- Envelope icon -->
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0a718d" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                </span>
                <div>
                  <p class="font-heading font-semibold text-ink text-sm mb-0.5">Email</p>
                  <a
                    href="mailto:hello@dwellr.ng"
                    class="font-body text-ink-mid text-sm hover:text-secondary transition-colors duration-150"
                  >
                    hello@dwellr.ng
                  </a>
                </div>
              </li>

              <!-- Location — §6.6 spec -->
              <li class="flex items-start gap-4">
                <span
                  class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5"
                  aria-hidden="true"
                >
                  <!-- Map pin icon -->
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0a718d" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                </span>
                <div>
                  <p class="font-heading font-semibold text-ink text-sm mb-0.5">Location</p>
                  <p class="font-body text-ink-mid text-sm">Uyo, Akwa Ibom State, Nigeria</p>
                </div>
              </li>

              <!-- Registered Address — §6.6 spec -->
              <li class="flex items-start gap-4">
                <span
                  class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5"
                  aria-hidden="true"
                >
                  <!-- Building icon -->
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0a718d" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="2" width="16" height="20" rx="1" />
                    <line x1="9" y1="2" x2="9" y2="22" />
                    <line x1="15" y1="2" x2="15" y2="22" />
                    <line x1="4" y1="7" x2="9" y2="7" />
                    <line x1="4" y1="12" x2="9" y2="12" />
                    <line x1="4" y1="17" x2="9" y2="17" />
                    <line x1="15" y1="7" x2="20" y2="7" />
                    <line x1="15" y1="12" x2="20" y2="12" />
                    <line x1="15" y1="17" x2="20" y2="17" />
                  </svg>
                </span>
                <div>
                  <p class="font-heading font-semibold text-ink text-sm mb-0.5">Registered Address</p>
                  <p class="font-body text-ink-mid text-sm leading-relaxed">
                    4, Udo Ekong Close, Akpa Ube,<br />
                    Aka Road, Uyo, Akwa Ibom State, Nigeria
                  </p>
                </div>
              </li>

              <!-- D-U-N-S — §6.6 spec -->
              <li class="flex items-start gap-4">
                <span
                  class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 mt-0.5"
                  aria-hidden="true"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0a718d" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2" />
                    <line x1="2" y1="10" x2="22" y2="10" />
                  </svg>
                </span>
                <div>
                  <p class="font-heading font-semibold text-ink text-sm mb-0.5">D-U-N-S</p>
                  <p class="font-body text-ink-mid text-sm">669828461</p>
                </div>
              </li>
            </ul>
          </div>

          <!-- Response time note — §6.6 spec -->
          <p class="font-body text-muted text-sm mt-4 px-1">
            We aim to respond to all enquiries within 2 business days.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
