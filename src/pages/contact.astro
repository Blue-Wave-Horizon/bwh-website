---
// Contact page (/contact)
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import Email from '../components/ui/Email.astro';
---

<BaseLayout
  title="Contact — Blue Wave Horizon"
  description="Get in touch with Blue Wave Horizon about a project, a partnership or one of our products."
>
  <PageHero
    eyebrow="Contact"
    title="Tell us what you're building."
    lead="A project, a partnership or a question about one of our products. Every message is read by the person who would do the work."
  />

  <section class="wrap flex flex-col gap-14 pb-20 sm:pb-28 lg:flex-row lg:items-start lg:gap-24">
    <div class="lg:flex-[1.4]">
      <ContactForm />
    </div>

    <dl class="flex flex-col border-b border-line-strong lg:flex-1">
      <div class="flex flex-col gap-1 border-t border-line-strong py-6">
        <dt class="text-sm font-semibold uppercase tracking-[0.06em] text-ink-mid">Email</dt>
        <dd class="text-[19px] font-semibold">
          <Email class="text-link hover:opacity-80" />
        </dd>
      </div>
      <div class="flex flex-col gap-1 border-t border-line-strong py-6">
        <dt class="text-sm font-semibold uppercase tracking-[0.06em] text-ink-mid">Response time</dt>
        <dd class="text-[19px] font-semibold">Within two working days</dd>
      </div>
      <div class="flex flex-col gap-1 border-t border-line-strong py-6">
        <dt class="text-sm font-semibold uppercase tracking-[0.06em] text-ink-mid">Location</dt>
        <dd class="text-[19px] font-semibold">Uyo, Akwa Ibom State, Nigeria</dd>
      </div>
      <div class="flex flex-col gap-1 border-t border-line-strong py-6">
        <dt class="text-sm font-semibold uppercase tracking-[0.06em] text-ink-mid">Registered address</dt>
        <dd class="text-ink-mid">
          Blue Wave Horizon Ltd. (RC 9357879)<br />
          4, Udo Ekong Close, Akpa Ube, Aka Road, Uyo, Akwa Ibom State, Nigeria
        </dd>
      </div>
    </dl>
  </section>
</BaseLayout>
