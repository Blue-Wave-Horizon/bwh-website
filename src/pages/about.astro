---
// About page (/about)
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import FounderBio from '../components/sections/FounderBio.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import Email from '../components/ui/Email.astro';

const details = [
  { label: 'Legal name', value: 'Blue Wave Horizon Ltd.' },
  { label: 'Registration', value: 'RC 9357879 (Nigeria)' },
  { label: 'D-U-N-S', value: '669828461' },
  {
    label: 'Registered address',
    value: '4, Udo Ekong Close, Akpa Ube, Aka Road, Uyo, Akwa Ibom State, Nigeria',
  },
];
---

<BaseLayout
  title="About Blue Wave Horizon | Software Company in Nigeria"
  description="Blue Wave Horizon is a founder-led software company in Uyo, Nigeria. One engineer designs, builds, ships and maintains every product and client project."
>
  <PageHero
    eyebrow="About"
    title="One engineer. Full responsibility."
    lead="Blue Wave Horizon is a software company based in Uyo, Nigeria. It exists to build software that is direct, efficient and made with care."
  />

  <FounderBio full />

  <section class="wrap section flex flex-col gap-8 lg:flex-row lg:gap-20">
    <h2 class="h-section lg:flex-1">Why we build what we build</h2>
    <div class="flex flex-col gap-5 text-lg text-ink-mid sm:text-[19px] lg:flex-[1.3]">
      <p>
        Renting a home in Nigeria usually means paying an agent a large fee for very little. Dwellr
        is our answer to that.
      </p>
      <p>
        PC gaming assumes you need to buy a controller to play well. VeloPad starts from the fact
        that the phone in your pocket is already a precise input device.
      </p>
      <p>
        Both began the same way: something was more awkward or more expensive than it needed to be,
        and software could fix it.
      </p>
    </div>
  </section>

  <section class="bg-alt">
    <div class="wrap section flex flex-col gap-10 sm:gap-14">
      <h2 class="h-section">How we work</h2>
      <div class="grid gap-5 sm:gap-6 md:grid-cols-3">
        <FeatureCard title="Ownership">
          We build it, ship it and answer for it. Responsibility isn't handed to anyone else.
        </FeatureCard>
        <FeatureCard title="Initiative">
          We spot the problem and move. Waiting isn't a plan.
        </FeatureCard>
        <FeatureCard title="Craft">
          Fewer things, done properly. We ship when it's ready, and the details are the work.
        </FeatureCard>
      </div>
    </div>
  </section>

  <section class="wrap section flex flex-col gap-8 lg:flex-row lg:gap-20">
    <h2
      class="font-heading font-semibold lg:flex-1"
      style="font-size: clamp(1.625rem, 3.2vw, 2.5rem); line-height: 1.12; letter-spacing: -0.03em;"
    >
      Company details
    </h2>
    <dl class="flex flex-col border-b border-line-strong lg:flex-[1.3]">
      {
        details.map((row) => (
          <div class="flex flex-col gap-1 border-t border-line-strong py-5 sm:flex-row sm:gap-8">
            <dt class="text-ink-mid sm:w-[180px] sm:shrink-0">{row.label}</dt>
            <dd class="font-semibold">{row.value}</dd>
          </div>
        ))
      }
      <div class="flex flex-col gap-1 border-t border-line-strong py-5 sm:flex-row sm:gap-8">
        <dt class="text-ink-mid sm:w-[180px] sm:shrink-0">Email</dt>
        <dd class="font-semibold">
          <Email class="text-link hover:opacity-80" />
        </dd>
      </div>
    </dl>
  </section>

  <CtaBand
    tinted
    title="Have something to build?"
    text="Tell us what you need. You'll get a straight answer on whether we're the right fit."
  />
</BaseLayout>
